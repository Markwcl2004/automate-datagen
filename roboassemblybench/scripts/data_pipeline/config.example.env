# Settings read by the data-pipeline scripts. Copy, edit, then load into the shell:
#   set -a; source config.env; set +a
SHARED_ROOT=/path/to/shared/disk                # seed ledger, policies and outputs live under it (shared by all hosts)
PRODUCTION=automate_fullproc_20261004           # dataset name = batch id written into every episode
PROFILE=mixed                                   # visual randomization profile
DATASET_ROOT=$SHARED_ROOT/datasets/$PRODUCTION  # raw episodes: <task>/<profile>/episode_<idx>_cartesian_raw/
EXPORT_ROOT=$SHARED_ROOT/exports/$PRODUCTION    # LeRobot v3 datasets: <robot type>/<task>/<profile>/
ROBOT_TYPE=franka_panda_single_arm
TARGET=1200                                     # kept episodes per task
NENV=16                                         # envs per collector process
SLOTS=3                                         # processes that may collect the same task at once
QTAG=main                                       # queue tag: a new tag = fresh claims for a new pass over the tasks
TASK_CONFIG=/path/to/tasks.txt                  # <task> <experiment> <iteration> [<grasp raise m | ->] [<deeper_ok 0|1>]
POLICY_ROOT=$SHARED_ROOT/outputs/isaaclab_logs/rl_games/Assembly   # <experiment>/nn/last_Assembly_ep_<iteration>_*.pth
AUTOMATE_VISUAL_ASSETS=$SHARED_ROOT/data/visual_assets             # fabrica_textures/ and warehouse_props/ with manifests
# KIT_LOCAL_ROOT=/local/disk/dir                # Kit portable roots (must not be on NFS); default $TMPDIR/automate_kitroot
# PYTHON=python3                                # numpy + ffmpeg for the filter / audit / QC; pyarrow >= 17 for the exporter
# EXPORT_PYTHONPATH=/path/to/pyarrow/site      # extra PYTHONPATH for the exporter, if pyarrow is installed apart
# VALIDATOR_DIR=/path/to/validator              # optional: directory with the evaluator's export_features.py
